# ── Aria Realty IDX configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in the values you receive from your MLS.
# Until RESO credentials are set, the site runs on the bundled sample data.

PORT=3000

# Which MLS feed to use. Peachtree City brokers typically belong to
# FMLS (First MLS) and/or Georgia MLS (GAMLS). Both offer RESO Web API feeds.
#   FMLS  API base:   https://api.fmls.com  (issued at signup — confirm with FMLS)
#   GAMLS API base:   issued by Georgia MLS when your data license is approved
RESO_API_BASE_URL=
RESO_TOKEN_URL=
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
# Some MLSs issue a long-lived bearer token instead of OAuth2 client credentials:
RESO_ACCESS_TOKEN=

# OData resource + filter. $filter narrows the replication to your market.
RESO_RESOURCE=Property
RESO_FILTER=StandardStatus eq 'Active' and (City eq 'Peachtree City' or City eq 'Fayetteville' or City eq 'Tyrone' or City eq 'Senoia' or City eq 'Newnan' or City eq 'Sharpsburg' or City eq 'Brooks')
RESO_PAGE_SIZE=200

# How often to refresh listings (minutes). MLS rules commonly require IDX data
# to be refreshed at least every 12 hours; every 60 min is a safe default.
SYNC_INTERVAL_MINUTES=60

# Your brokerage name exactly as it appears in the MLS (used to flag "our listings")
BROKERAGE_OFFICE_NAME=Aria Realty Inc.

# Where lead-capture form submissions are appended (JSON lines).
# NOTE: on Render's free tier this file is wiped on every redeploy. Treat it as a
# backstop, not storage — configure the email settings below so leads actually reach you.
LEADS_FILE=../data/leads.jsonl

# ── Lead notification email (Resend) ──────────────────────────────────────────
# Every contact / valuation / showing-request submission is emailed here.
# Without RESEND_API_KEY and LEAD_EMAIL_TO, leads are only written to LEADS_FILE.
#
# Setup, once:
#   1. Create a free account at resend.com (3,000 emails/month).
#   2. Domains → Add Domain → ariarealtyinc.com, then add the DNS records it
#      shows you (SPF + DKIM) at your registrar. Verification takes a few minutes.
#   3. API Keys → Create API Key, with "Sending access". Paste it below.
#   4. On Render, add these same three variables under Environment.
#
# LEAD_EMAIL_FROM must be on the domain verified in step 2, or Resend rejects it.
RESEND_API_KEY=
LEAD_EMAIL_TO=info@ariarealtyinc.com
LEAD_EMAIL_FROM=Aria Realty Website <website@ariarealtyinc.com>
# LEAD_EMAIL_TO accepts several addresses, comma-separated:
# LEAD_EMAIL_TO=info@ariarealtyinc.com,tahir@ariarealtyinc.com
